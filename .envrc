# direnv: https://direnv.net — run `direnv allow` once after cloning or editing.

# Node: switch to the version pinned in .nvmrc when nvm is available
# (other version managers can be wired up in .envrc.local instead).
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" --no-use
  nvm use --silent >/dev/null || log_error "nvm: run 'nvm install' to get the Node version in .nvmrc"
fi

# Workspace-root tool binaries (playwright, vitest, eslint, prettier, ...).
PATH_add node_modules/.bin

# Personal, uncommitted overrides (gitignored via *.local).
source_env_if_exists .envrc.local
